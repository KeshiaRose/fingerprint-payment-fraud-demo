<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fingerprint Payment Fraud Demo</title>
    <link rel="icon" href="/images/favicon.ico" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      .fire {
        color: #f35b22 !important;
      }

      .bg-fire {
        background-color: #f35b22 !important;
      }

      .bg-fire-light:hover {
        background-color: #ff7e59 !important;
      }

      .ring-fire:focus {
        outline: none;
        --ring-color: #f35b22 !important;
        --tw-ring-color: #f35b22 !important;
      }

      .border-fire,
      .border-fire:focus {
        border-color: #f35b22 !important;
      }
    </style>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="/js/checkout.js" defer></script>
  </head>
  <body id="app">
    <div class="mx-auto max-w-screen-xl px-4 pb-8 2xl:px-0">
      <h1
        class="w-full mt-10 mb-8 text-4xl font-extrabold md:max-w-2xl md:text-5xl xl:text-6xl fire"
      >
        Awesome Store
      </h1>

      <!-- Breadcrumbs -->
      <div
        class="flex items-center justify-between max-w-2xl text-sm font-medium text-gray-500 sm:text-base"
      >
        <div class="flex items-center space-x-2">
          <svg
            class="h-5 w-5 text-gray-500"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            />
          </svg>
          <p class="text-gray-500">Cart</p>
        </div>

        <div class="h-px w-10 bg-gray-200"></div>

        <div class="flex items-center space-x-2">
          <svg
            class="h-5 w-5 text-gray-500"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            />
          </svg>
          <p class="text-gray-500">Shipping</p>
        </div>

        <div class="h-px w-10 bg-gray-200"></div>

        <div class="flex items-center space-x-2">
          <svg
            class="h-5 w-5 text-gray-500"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            />
          </svg>
          <p class="text-gray-500">Payment</p>
        </div>

        <div class="h-px w-10 bg-gray-200"></div>

        <div class="flex items-center space-x-2">
          <svg
            class="h-5 w-5 fire"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.5 11.5 11 14l4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            />
          </svg>
          <p class="fire">Order review</p>
        </div>
      </div>

      <div class="mt-6 sm:mt-8 lg:flex lg:items-start lg:gap-12 xl:gap-16">
        <!-- Details -->
        <div class="min-w-0 flex-1 space-y-8">
          <!-- Items -->

          <div class="space-y-4">
            <h2 class="text-xl font-semibold text-gray-900">Items</h2>
            <div class="divide-y divide-gray-200">
              <div
                v-for="item in items"
                class="flex items-center justify-between text-right py-2"
              >
                <div class="h-16 w-16 rounded">
                  <img
                    :src="'/images/'+item.id+'.png'"
                    :alt="item.name"
                    class="h-16 w-16 object-cover rounded"
                  />
                </div>
                <div>
                  <p class="text-gray-900 text-lg font-bold">
                    {{ item.name }}
                  </p>
                  <p class="text-gray-500 text-sm">
                    Quantity: {{ item.quantity }}
                  </p>
                  <p class="text-gray-900 font-medium">
                    ${{ item.price.toFixed(2) }}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Shipping -->
          <div class="space-y-4">
            <h2 class="text-xl font-semibold text-gray-900">
              Shipping Address
            </h2>

            <div
              class="space-y-4 sm:space-y-2 rounded-lg border border-gray-100 bg-gray-50 p-6 mb-6 md:mb-8"
            >
              <p class="text-lg font-bold text-gray-900">Jamie Doe</p>
              <p class="font-medium text-gray-900">456 Lakeview Avenue</p>
              <p class="font-medium text-gray-900">Seattle, WA 98102</p>
            </div>
          </div>

          <!-- Contact -->
          <div class="space-y-4">
            <h2 class="text-xl font-semibold text-gray-900">
              Contact Information
            </h2>

            <div
              class="space-y-4 sm:space-y-2 rounded-lg border border-gray-100 bg-gray-50 p-6 mb-6 md:mb-8"
            >
              <p class="font-medium text-gray-900">jamie.doe@example.com</p>
              <p class="font-medium text-gray-900">+1 (206) 555-1234</p>
            </div>
          </div>

          <!-- Payment -->
          <div class="space-y-4">
            <h3 class="text-xl font-semibold text-gray-900">Payment</h3>
            <div
              class="space-y-4 sm:space-y-2 rounded-lg border border-gray-100 bg-gray-50 p-6 mb-6 md:mb-8 flex items-center"
            >
              <div
                class="flex justify-center items-center h-6 w-10 bg-white rounded-sm border border-gray-200"
              >
                <img src="/images/visa.png" alt="Card Icon" />
              </div>
              <div class="ml-4">
                <p class="font-medium text-gray-900">Visa ending in 1234</p>
                <p class="text-gray-500">Expires 04/28</p>
              </div>
            </div>

            <div class="flex items-center space-x-2">
              <input
                type="checkbox"
                id="same-address"
                checked
                class="h-4 w-4 text-fire border-gray-300 rounded ring-fire"
              />
              <label
                for="same-address"
                class="text-gray-700 text-sm font-medium"
              >
                Payment address is the same as shipping address
              </label>
            </div>
          </div>

          <div class="space-y-4">
            <h2 class="text-xl font-semibold text-gray-900">Delivery Method</h2>

            <div
              class="space-y-4 sm:space-y-2 rounded-lg border border-gray-100 bg-gray-50 p-6 mb-6 md:mb-8"
            >
              <div class="">
                <label
                  for="fedex"
                  class="font-medium leading-none text-gray-900"
                >
                  Free Delivery - FedEx
                </label>
                <p
                  id="fedex-text"
                  class="mt-1 text-xs font-normal text-gray-500"
                >
                  Get it by Friday, 24 Jan 2025
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Totals -->
        <div
          class="mt-6 w-full space-y-6 sm:mt-8 lg:mt-0 lg:max-w-xs xl:max-w-md"
        >
          <div class="flow-root">
            <div class="-my-3 divide-y divide-gray-200">
              <dl class="flex items-center justify-between gap-4 py-3">
                <dt class="text-base font-normal text-gray-500">Subtotal</dt>
                <dd class="text-base font-medium text-gray-900">
                  ${{ subtotal.toFixed(2) }}
                </dd>
              </dl>

              <dl
                v-if="savings > 0"
                class="flex items-center justify-between gap-4 py-3"
              >
                <dt class="text-base font-normal text-gray-500">Savings</dt>
                <dd class="text-base font-medium text-green-500">
                  -${{ savings.toFixed(2) }}
                </dd>
              </dl>

              <dl class="flex items-center justify-between gap-4 py-3">
                <dt class="text-base font-normal text-gray-500">
                  Shipping & Handling
                </dt>
                <dd class="text-base font-medium text-gray-900">$0.00</dd>
              </dl>

              <dl class="flex items-center justify-between gap-4 py-3">
                <dt class="text-base font-normal text-gray-500">Tax</dt>
                <dd class="text-base font-medium text-gray-900">
                  ${{ tax.toFixed(2) }}
                </dd>
              </dl>

              <dl class="flex items-center justify-between gap-4 py-3">
                <dt class="text-base font-bold text-gray-900">Total</dt>
                <dd class="text-base font-bold text-gray-900">
                  ${{ total.toFixed(2) }}
                </dd>
              </dl>
            </div>
          </div>

          <div class="space-y-6">
            <button
              @click="submitOrder"
              class="flex w-full items-center justify-center rounded-lg bg-fire px-5 py-2.5 text-sm font-medium text-white bg-fire-light focus:outline-none focus:ring-2 ring-fire"
            >
              Complete Order
            </button>

            <div
              v-if="orderError"
              class="flex items-center w-full p-4 mb-4 text-gray-500 bg-white rounded-lg shadow"
              role="alert"
            >
              <div
                class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-red-500 bg-red-100 rounded-lg"
              >
                <svg
                  class="w-5 h-5"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"
                  />
                </svg>
                <span class="sr-only">Error</span>
              </div>
              <div class="ms-3 text-sm font-normal">
                {{ orderError }}
              </div>
              <button
                @click="orderError = ''"
                class="ms-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8"
                data-dismiss-target="#toast-danger"
                aria-label="Close"
              >
                <span class="sr-only">Close</span>
                <svg
                  class="w-3 h-3"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 14 14"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
                  />
                </svg>
              </button>
            </div>

            <div
              v-if="orderWarning"
              class="flex items-center w-full p-4 mb-4 text-gray-500 bg-white rounded-lg shadow"
              role="alert"
            >
              <div
                class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-orange-500 bg-orange-100 rounded-lg dark:bg-orange-700 dark:text-orange-200"
              >
                <svg
                  class="w-5 h-5"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"
                  />
                </svg>
                <span class="sr-only">Warning icon</span>
              </div>
              <div class="ms-3 text-sm font-normal">
                {{ orderWarning }}
              </div>
              <button
                @click="orderWarning = ''"
                class="ms-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8"
                data-dismiss-target="#toast-danger"
                aria-label="Close"
              >
                <span class="sr-only">Close</span>
                <svg
                  class="w-3 h-3"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 14 14"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
                  />
                </svg>
              </button>
            </div>

            <div
              v-if="!couponApplied"
              class="space-y-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6"
            >
              <div>
                <label
                  for="voucher"
                  class="mb-2 block text-sm font-medium text-gray-900"
                >
                  Do you have a coupon code?
                </label>
                <input
                  type="text"
                  id="voucher"
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-fire focus:ring-2 ring-fire uppercase"
                  placeholder=""
                  v-model="coupon"
                />
              </div>
              <div>
                <button
                  @click="applyCoupon"
                  class="flex w-full items-center justify-center rounded-lg bg-fire px-5 py-2.5 text-sm font-medium text-white bg-fire-light focus:outline-none focus:ring-2 ring-fire"
                >
                  Apply Coupon
                </button>
                <p class="italic text-xs text-gray-500 text-center pt-1">
                  Only one coupon allowed per order.
                </p>
              </div>
              <div
                v-if="couponError"
                class="flex items-center w-full p-4 mb-4 text-gray-500 bg-white rounded-lg shadow"
                role="alert"
              >
                <div
                  class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-red-500 bg-red-100 rounded-lg"
                >
                  <svg
                    class="w-5 h-5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"
                    />
                  </svg>
                  <span class="sr-only">Error</span>
                </div>
                <div class="ms-3 text-sm font-normal">
                  {{ couponError }}
                </div>
                <button
                  @click="couponError = ''"
                  class="ms-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex items-center justify-center h-8 w-8"
                  data-dismiss-target="#toast-danger"
                  aria-label="Close"
                >
                  <span class="sr-only">Close</span>
                  <svg
                    class="w-3 h-3"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 14 14"
                  >
                    <path
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
                    />
                  </svg>
                </button>
              </div>
            </div>

            <div
              v-if="coupon && couponApplied"
              class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 flex items-center justify-between"
            >
              <p class="block text-sm font-medium text-gray-900">
                <span class="font-bold">{{ coupon.toUpperCase() }}</span> coupon
                applied! You're getting {{ couponPercent * 100 }}% off!
              </p>
              <button
                @click="removeCoupon"
                class="text-gray-700 border border-gray-300 rounded px-3 py-1 text-xs font-medium hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-300"
              >
                Remove
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
